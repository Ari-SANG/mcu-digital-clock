 135          unsigned char Board_ReadTemperature(unsigned char data *decimal)
 136          {
 137   1          unsigned int data adc;
 138   1          unsigned int data remaining;
 139   1          unsigned char data whole;
 140   1      
 141   1          ADC_CONTR = 0x88;
 142   1          _nop_(); _nop_(); _nop_(); _nop_();
 143   1          remaining = ADC_WAIT_LIMIT;
 144   1          while ((ADC_CONTR & 0x10U) == 0U)
 145   1          {
 146   2              if (--remaining == 0U)
 147   2              {
 148   3                  *decimal = 0xFFU;
 149   3                  return 0xFFU;
 150   3              }
 151   2          }
 152   1          ADC_CONTR &= ~0x10U;
 153   1          adc = ((unsigned int)ADC_RES << 2) | (ADC_RESL & 0x03U);
 154   1          adc -= adc >> 4;
 155   1          if (adc < 230U) adc = 230U;
 156   1          adc -= 230U;
 157   1          whole = 0;
 158   1          while (adc >= 10U) { adc -= 10U; whole++; }
 159   1          *decimal = (unsigned char)adc;
 160   1          return whole;
 161   1      }
