 129          unsigned char Board_ReadTemperature(unsigned char data *decimal)
 130          {
 131   1          unsigned int data adc;
 132   1          unsigned char data whole;
 133   1      
 134   1          ADC_CONTR = 0x88;
 135   1          while ((ADC_CONTR & 0x10U) == 0U);
 136   1          ADC_CONTR &= ~0x10U;
 137   1          adc = ((unsigned int)ADC_RES << 2) | ADC_RESL;
 138   1          adc -= adc >> 4;
 139   1          if (adc < 230U) adc = 230U;
 140   1          adc -= 230U;
 141   1          whole = 0;
 142   1          while (adc >= 10U) { adc -= 10U; whole++; }
 143   1          *decimal = (unsigned char)adc;
 144   1          return whole;
 145   1      }
