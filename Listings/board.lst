 121          unsigned char Board_ReadTemperature(unsigned char data *decimal)
 122          {
 123   1          unsigned int data adc;
 124   1          unsigned char data whole;
 125   1      
 126   1          ADC_CONTR = 0x88;
 127   1          while ((ADC_CONTR & 0x10U) == 0U);
 128   1          ADC_CONTR &= ~0x10U;
 129   1          adc = ((unsigned int)ADC_RES << 2) | ADC_RESL;
 130   1          adc -= adc >> 4;
 131   1          if (adc < 230U) adc = 230U;
 132   1          adc -= 230U;
 133   1          whole = 0;
 134   1          while (adc >= 10U) { adc -= 10U; whole++; }
 135   1          *decimal = (unsigned char)adc;
 136   1          return whole;
 137   1      }
