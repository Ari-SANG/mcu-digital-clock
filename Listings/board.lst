 119          unsigned char Board_ReadTemperature(unsigned char data *decimal)
 120          {
 121   1          unsigned int data adc;
 122   1          unsigned char data whole;
 123   1      
 124   1          ADC_CONTR = 0x88;
 125   1          while ((ADC_CONTR & 0x10U) == 0U);
 126   1          ADC_CONTR &= ~0x10U;
 127   1          adc = ((unsigned int)ADC_RES << 2) | ADC_RESL;
 128   1          adc -= adc >> 4;
 129   1          if (adc < 230U) adc = 230U;
 130   1          adc -= 230U;
 131   1          whole = 0;
 132   1          while (adc >= 10U) { adc -= 10U; whole++; }
 133   1          *decimal = (unsigned char)adc;
 134   1          return whole;
 135   1      }
