   1          /* P1.3/P1.4/P1.5 debounce and non-blocking hold-repeat generation. */
   2          //按键消抖与长按连发
   3          
   4          #include <STC15.H>
   5          #include "config.h"
   6          #include "keys.h"
   7          
   8          sbit KEY_MODE = P1^3;
   9          sbit KEY_MINUS = P1^4;
  10          sbit KEY_PLUS = P1^5;
  11          
  12          static unsigned char data KeyStable;
  13          static unsigned char data KeyDebounce[3];
  14          static unsigned char data KeyHold[3];
  15          
  16          void Keys_Init(void)
  17          {
  18   1          KEY_MODE = 1;
  19   1          KEY_MINUS = 1;
  20   1          KEY_PLUS = 1;
  21   1          P1M1 &= ~0x38;
  22   1          P1M0 &= ~0x38;
  23   1          KeyStable = 0;
  24   1      }
  25          
  26          unsigned char Keys_Scan10ms(void)
  27          {
  28   1          unsigned char raw;
  29   1          unsigned char events;
  30   1          unsigned char i;
  31   1          unsigned char mask;
  32   1      
  33   1          raw = 0;
  34   1          if (!KEY_MODE) raw |= KEY_EVENT_MODE;
  35   1          if (!KEY_MINUS) raw |= KEY_EVENT_MINUS;
  36   1          if (!KEY_PLUS) raw |= KEY_EVENT_PLUS;
  37   1          events = KEY_EVENT_NONE;
  38   1      
  39   1          for (i = 0; i < 3U; i++)
  40   1          {
  41   2              mask = 1U << i;
  42   2              if ((raw & mask) == (KeyStable & mask))
  43   2                  KeyDebounce[i] = 0;
  44   2              else if (++KeyDebounce[i] >= KEY_DEBOUNCE_TICKS)
  45   2              {
  46   3                  KeyDebounce[i] = 0;
  47   3                  if (raw & mask)
  48   3                  {
  49   4                      KeyStable |= mask;
  50   4                      KeyHold[i] = 0;
  51   4                      events |= mask;
  52   4                  }
  53   3                  else
  54   3                  {
C51 COMPILER V9.60.7.0   KEYS                                                              09/11/2026 09:31:59 PAGE 2   

  55   4                      KeyStable &= ~mask;
  56   4                      KeyHold[i] = 0;
  57   4                  }
  58   3              }
  59   2      
  60   2              if ((i != 0U) && (KeyStable & mask))
  61   2              {
  62   3                  if (++KeyHold[i] >= KEY_REPEAT_START_TICKS)
  63   3                  {
  64   4                      if (mask == KEY_EVENT_PLUS)
  65   4                          events |= KEY_EVENT_PLUS_REPEAT;
  66   4                      else
  67   4                          events |= mask;
  68   4                      KeyHold[i] = KEY_REPEAT_START_TICKS - KEY_REPEAT_STEP_TICKS;
  69   4                  }
  70   3              }
  71   2          }
  72   1          return events;
  73   1      }


