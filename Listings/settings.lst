 379   1          {
 380   2              target_sector = (ActiveSector == 0U) ? 1U : 0U;
 381   2              Settings_IapErase(Settings_SectorAddress(target_sector));
 382   2              address = Settings_FindBlankSlot(target_sector);
 383   2          }
 384   1          else
 385   1              target_sector = ActiveSector;
 386   1      
 387   1          if (address == SETTINGS_INVALID_ADDR)
 388   1          {
 389   2              Settings_SaveFailed();
