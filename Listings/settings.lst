 366          void Settings_Service(void)
 367          {
 368   1          unsigned char data target_sector;
 369   1          unsigned int data address;
 370   1      
 371   1          if (!SavePending) return;
 372   1      
 373   1          if (ActiveSector < SETTINGS_SECTOR_COUNT)
