 138          static bit Settings_RecordFieldsValid(void)
 139          {
 140   1          unsigned char data index;
 141   1          unsigned char data offset;
 142   1          unsigned char data flags;
 143   1      
 144   1          if ((RecordBuffer[OFFSET_CLOCK_HOUR] >= 24U) ||
