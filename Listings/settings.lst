 117          static unsigned char Settings_Crc8(unsigned char length)
 118          {
 119   1          unsigned char data crc;
 120   1          unsigned char data value;
 121   1          unsigned char data byte_index;
 122   1          unsigned char data bit_index;
 123   1      
 124   1          crc = 0;
 125   1          for (byte_index = 0; byte_index < length; byte_index++)
 126   1          {
 127   2              value = RecordBuffer[byte_index];
 128   2              crc ^= value;
 129   2              for (bit_index = 0; bit_index < 8U; bit_index++)
 130   2              {
 131   3                  if (crc & 0x80U) crc = (crc << 1) ^ 0x07U;
 132   3                  else crc <<= 1;
 133   3              }
 134   2          }
 135   1          return crc;
 136   1      }
