 157   1          for (index = 0; index < ALARM_COUNT; index++)
 158   1          {
 159   2              offset = OFFSET_ALARMS + index * 3U;
 160   2              if ((RecordBuffer[offset] >= 24U) ||
 161   2                  (RecordBuffer[offset + 1U] >= 60U) ||
 162   2                  (RecordBuffer[offset + 2U] >= MUSIC_COUNT))
 163   2                  return 0;
 164   2          }
 165   1          return 1;
 166   1      }
